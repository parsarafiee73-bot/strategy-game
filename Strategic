# SCORE
# ============================================================

def score_country(c):
    return (
        c[5] // 2
        + c[3] // 50
        + c[9] * 5
        + c[11] * 4
        + c[12] * 3
        + c[13] * 60
        + (
            c[16]
            + c[17]
            + c[18]
            + c[19]
            + c[20]
            + c[21]
        ) * 25
    )


def update_score(cur, chat_id, country):
    cur.execute(
        """
        SELECT *
        FROM countries
        WHERE chat_id=%s AND name=%s
        """,
        (chat_id, country)
    )

    c = cur.fetchone()

    if not c:
        return

    score = score_country(c)

    cur.execute(
        """
        UPDATE countries
        SET score=%s
        WHERE chat_id=%s AND name=%s
        """,
        (score, chat_id, country)
    )



def get_owned_country(chat_id, user_id):
    with db() as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT name
                FROM countries
                WHERE chat_id=%s AND owner_id=%s
                """,
                (chat_id, user_id)
            )

            row = cur.fetchone()

            return row[0] if row else None


